generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id                  String     @id @default(uuid())
  title               String
  description         String?    @default("")
  status              String     @default("To Do")
  priority            String     @default("Medium")
  dueDate             String?
  dueTime             String?
  category            String     @default("General")
  notes               String?    @default("")
  notificationEnabled Boolean    @default(true)
  notificationSent    Boolean    @default(false)
  notificationBefore  Int        @default(15)
  beforeNotifiedAt    DateTime?
  dueNotifiedAt       DateTime?
  overdueNotifiedAt   DateTime?
  lastNotifiedAt      DateTime?
  outlookEventId      String?
  outlookSyncStatus   String?    @default("Pending")
  outlookSyncError    String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  reminders           Reminder[]
}

model Reminder {
  id                  String    @id @default(uuid())
  title               String    @default("Executive Reminder")
  taskId              String?
  reminderTime        DateTime
  channel             String    @default("In-App")
  triggered           Boolean   @default(false)
  notificationEnabled Boolean   @default(true)
  notificationSent    Boolean   @default(false)
  notificationBefore  Int       @default(15)
  beforeNotifiedAt    DateTime?
  dueNotifiedAt       DateTime?
  overdueNotifiedAt   DateTime?
  lastNotifiedAt      DateTime?
  outlookEventId      String?
  outlookSyncStatus   String?   @default("Pending")
  outlookSyncError    String?
  createdAt           DateTime  @default(now())
  task                Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id                String   @id @default(uuid())
  title             String
  description       String?  @default("")
  location          String?  @default("")
  startTime         DateTime
  endTime           DateTime
  isAllDay          Boolean  @default(false)
  category          String   @default("Meeting")
  outlookEventId    String?
  outlookSyncStatus String?  @default("Pending")
  outlookSyncError  String?
  createdAt         DateTime @default(now())
}

model EmailDraft {
  id        String   @id @default(uuid())
  recipient String
  subject   String
  body      String
  status    String   @default("Draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bcc       String?  @default("")
  cc        String?  @default("")
}

model Memory {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String   @default("Preferences")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Conversation {
  id         String   @id @default(uuid())
  role       String
  content    String
  actionData String?
  timestamp  DateTime @default(now())
}

model GoogleConnection {
  id           String   @id @default("primary")
  email        String?
  accessToken  String
  refreshToken String?
  tokenType    String?  @default("Bearer")
  expiryDate   String?
  scope        String?
  isConnected  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MicrosoftConnection {
  id           String   @id @default("primary")
  email        String?
  accessToken  String
  refreshToken String?
  tokenType    String?  @default("Bearer")
  expiryDate   String?
  scope        String?
  isConnected  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PushSubscription {
  id                           String    @id @default(uuid())
  endpoint                     String    @unique
  p256dh                       String
  auth                         String
  enabled                      Boolean   @default(true)
  taskNotificationsEnabled     Boolean   @default(true)
  reminderNotificationsEnabled Boolean   @default(true)
  frequencyHours               Int       @default(3)
  quietHoursEnabled            Boolean   @default(false)
  quietHoursStart              String    @default("22:00")
  quietHoursEnd                String    @default("07:00")
  timezone                     String    @default("Asia/Kolkata")
  lastSummaryNotifiedAt        DateTime?
  lastNotifiedAt               DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
}
