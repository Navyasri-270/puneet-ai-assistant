datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?  @default("")
  status      String   @default("To Do") // "To Do", "In Progress", "Completed"
  priority    String   @default("Medium") // "Low", "Medium", "High", "Urgent"
  dueDate     String?  // YYYY-MM-DD format
  dueTime     String?  // HH:MM AM/PM format
  category    String   @default("General") // e.g., Executive, Clients, Operations, Strategy
  notes       String?  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reminders   Reminder[]
}

model Reminder {
  id           String   @id @default(uuid())
  title        String   @default("Executive Reminder")
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reminderTime DateTime
  channel      String   @default("In-App") // "In-App", "Email"
  triggered    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  description String?  @default("")
  location    String?  @default("")
  startTime   DateTime
  endTime     DateTime
  isAllDay    Boolean  @default(false)
  category    String   @default("Meeting")
  createdAt   DateTime @default(now())
}

model EmailDraft {
  id        String   @id @default(uuid())
  recipient String
  cc        String?  @default("")
  bcc       String?  @default("")
  subject   String
  body      String
  status    String   @default("Draft") // "Draft", "Approved", "Cancelled"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Memory {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String   @default("Preferences") // Preferences, People, Clients, Communication, Business, Instructions, Other
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

model Conversation {
  id         String   @id @default(uuid())
  role       String   // "user", "assistant"
  content    String
  actionData String?  // JSON stringified action execution summary
  timestamp  DateTime @default(now())
}

model GoogleConnection {
  id           String   @id @default("primary")
  email        String?
  accessToken  String
  refreshToken String?
  tokenType    String?  @default("Bearer")
  expiryDate   String?
  scope        String?
  isConnected  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

